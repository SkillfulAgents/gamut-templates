# ATS API credentials
# Most ATS systems connect via OAuth through the Gamut connected-account flow.
# Only use this file if your ATS requires a direct API key.

# Greenhouse API key (if connecting via API rather than OAuth)
# GREENHOUSE_API_KEY=

# Ashby API key (if connecting via API rather than OAuth)
# ASHBY_API_KEY=

# Bullhorn REST API credentials (if not using the connected-account OAuth flow)
# BULLHORN_CLIENT_ID=
# BULLHORN_CLIENT_SECRET=

# Generic ATS API base URL (for custom or other ATS systems)
# ATS_API_BASE_URL=
# ATS_API_KEY=
